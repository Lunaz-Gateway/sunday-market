# Server-only: one Lunaz merchant API key per marketplace shop, never exposed to the browser
LUNAZ_SELLERS=[{"slug":"kedai-kopi-senja","apiKey":"lz_..."},{"slug":"batik-rumah","apiKey":"lz_..."},{"slug":"toko-buku-kecil","apiKey":"lz_..."},{"slug":"gadget-mungil","apiKey":"lz_..."},{"slug":"dapur-nenek","apiKey":"lz_..."}]
# Shop the /pos cashier charges for (default: first seller)
LUNAZ_POS_SELLER=kedai-kopi-senja
# Fallback when LUNAZ_SELLERS is unset: every shop uses this one key
LUNAZ_API_KEY=
LUNAZ_API_URL=http://127.0.0.1:8099
# Public: browser connects to the invoice WebSocket directly
VITE_LUNAZ_WS_URL=ws://127.0.0.1:8099
